{
  "name": "shaderoute",
  "version": "0.1.0",
  "description": "A mobile-first walking-route comparator using time-dependent clear-sky shade estimates.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasteraSnackin/shade-route.git"
  },
  "bugs": {
    "url": "https://github.com/MasteraSnackin/shade-route/issues"
  },
  "homepage": "https://github.com/MasteraSnackin/shade-route#readme",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:check": "node scripts/release-manifest.mjs --check",
    "release:verify": "npm run release:check && npm run audit:production && npm run lint && npm run typecheck && npm test",
    "benchmark:engine": "node tests/engine-performance.bench.mjs",
    "check:local-pilot": "node ops/check-pilot-routing.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .tmp"
  },
  "dependencies": {
    "maplibre-gl": "^6.3.0",
    "proj4": "^2.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "geotiff": "^3.0.5",
    "globals": "17.11.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
