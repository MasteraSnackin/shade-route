# Walking routing. The local Valhalla service in ops/valhalla listens here.
VALHALLA_URL=http://127.0.0.1:8002/route

# Keep the public FOSSGIS service as a fair-use development fallback only.
# A public pilot should use an independently operated endpoint instead.
VALHALLA_FALLBACK_URL=https://valhalla1.openstreetmap.de/route

# Optional provider authentication. These values are read only on the server.
VALHALLA_AUTH_HEADER=
VALHALLA_AUTH_TOKEN=
VALHALLA_FALLBACK_AUTH_HEADER=
VALHALLA_FALLBACK_AUTH_TOKEN=

# Privacy-preserving per-runtime guard. Public hosting should add a platform
# rate limit as well because edge runtimes do not share in-memory counters.
ROUTE_REQUESTS_PER_MINUTE=120
ROUTE_MAX_CONCURRENT=8

# Optional bounded place search providers. OS Names covers named places,
# streets and postcodes; Geoapify can additionally provide address autocomplete.
OS_NAMES_API_KEY=
# OS_DATA_HUB_API_KEY is accepted as an alias for OS_NAMES_API_KEY.
GEOAPIFY_API_KEY=

# Optional live journey context. TfL can use explicitly enabled anonymous
# access; a missing Met Office credential keeps that provider neutral.
# TfL permits lower-volume anonymous access; keep the five-minute server cache.
TFL_ALLOW_ANONYMOUS=true
TFL_API_KEY=
MET_OFFICE_API_KEY=

# Street Manager is intentionally not configurable with an authenticated
# GeoJSON JWT. DfT requires public-facing journey planners to use its registered
# Open Data service. That notification ingestion/current-state store is not yet
# implemented, so the roadworks provider remains explicitly disabled.
